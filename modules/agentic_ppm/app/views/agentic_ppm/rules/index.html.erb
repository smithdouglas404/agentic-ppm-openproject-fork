<% html_title t(:agentic_ppm_business_rules) %>

<h1><%= t(:agentic_ppm_business_rules) %></h1>

<section class="op-card-container" aria-label="<%= t(:agentic_ppm_rule_governance) %>">
  <h2><%= t(:agentic_ppm_rule_governance) %></h2>
  <p><%= t(:agentic_ppm_rule_governance_description) %></p>
  <p><%= t(:agentic_ppm_rule_validation_boundary) %></p>
</section>

<section class="op-card-container" aria-label="<%= t(:agentic_ppm_create_rule) %>">
  <h2><%= t(:agentic_ppm_create_rule) %></h2>
  <%= form_with model: @new_rule, url: agentic_ppm_rules_path(@project), method: :post do |form| %>
    <% if @new_rule.errors.any? %>
      <div class="op-toast -error"><%= @new_rule.errors.full_messages.to_sentence %></div>
    <% end %>
    <p>
      <%= form.label :name, t(:label_name) %>
      <%= form.text_field :name, required: true %>
    </p>
    <p>
      <%= form.label :category, t(:label_type) %>
      <%= form.select :category, options_for_select(AgenticPpm::BusinessRule::CATEGORIES.map { |category| [category.humanize, category] }), required: true %>
    </p>
    <p>
      <%= form.label :visual_flow_reference, t(:agentic_ppm_visual_flow_reference) %>
      <%= form.text_field :visual_flow_reference, placeholder: t(:agentic_ppm_visual_flow_reference_placeholder) %>
    </p>
    <%= form.submit t(:button_create), class: "button -primary" %>
  <% end %>
</section>

<section class="op-card-container" aria-label="<%= t(:agentic_ppm_business_rules) %>">
  <h2><%= t(:agentic_ppm_existing_rules) %></h2>
  <% if @rules.any? %>
    <table class="generic-table" aria-label="<%= t(:agentic_ppm_business_rules) %>">
      <thead>
        <tr>
          <th><%= t(:label_name) %></th>
          <th><%= t(:label_type) %></th>
          <th><%= t(:label_status) %></th>
          <th><%= t(:agentic_ppm_visual_flow_reference) %></th>
          <th><%= t(:label_actions) %></th>
        </tr>
      </thead>
      <tbody>
        <% @rules.each do |rule| %>
          <tr>
            <td><%= rule.name %></td>
            <td><%= rule.category.humanize %></td>
            <td><%= rule.state.humanize %></td>
            <td><%= rule.visual_flow_reference.presence || t(:label_none) %></td>
            <td>
              <% AgenticPpm::Rules::LifecycleService::TRANSITIONS.fetch(rule.state).each do |target_state| %>
                <%= button_to t(:agentic_ppm_transition_to, state: target_state.humanize), transition_agentic_ppm_rule_path(@project, rule), params: { target_state: target_state }, class: "button -small" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><%= t(:agentic_ppm_no_rules) %></p>
  <% end %>
</section>
