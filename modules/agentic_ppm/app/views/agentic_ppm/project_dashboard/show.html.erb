<% html_title t(:label_agentic_ppm) %>

<%= toolbar title: t(:label_agentic_ppm) %>

<section class="op-enterprise-banner" aria-labelledby="agentic-ppm-heading">
  <h2 id="agentic-ppm-heading"><%= t(:agentic_ppm_project_intelligence) %></h2>
  <p><%= t(:agentic_ppm_project_intelligence_description, project: project.name) %></p>
</section>

<section class="op-card-container" aria-label="<%= t(:agentic_ppm_capability_state) %>">
  <h3><%= t(:agentic_ppm_capability_state) %></h3>
  <table class="generic-table" aria-label="<%= t(:agentic_ppm_service_capabilities) %>">
    <thead>
      <tr>
        <th><%= t(:label_service) %></th>
        <th><%= t(:label_status) %></th>
      </tr>
    </thead>
    <tbody>
      <% capabilities.each do |service, state| %>
        <tr>
          <td><%= service.to_s.humanize %></td>
          <td><%= state == :configured ? t(:agentic_ppm_configured) : t(:agentic_ppm_not_configured) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="op-card-container" aria-label="<%= t(:agentic_ppm_specialists) %>">
  <h3><%= t(:agentic_ppm_specialists) %></h3>
  <p><%= t(:agentic_ppm_specialists_description) %></p>
  <ul>
    <% specialists.each do |specialist| %>
      <li><%= specialist %></li>
    <% end %>
  </ul>
</section>

<% if User.current.allowed_in_project?(:run_agentic_ppm_agents, project) %>
  <section class="op-card-container" aria-label="<%= t(:agentic_ppm_direct_conversations) %>">
    <h3><%= t(:agentic_ppm_direct_conversations) %></h3>
    <p><%= t(:agentic_ppm_direct_conversations_description) %></p>
    <%= form_with url: project_agentic_ppm_agent_runs_path(project), method: :post do |form| %>
      <p>
        <%= form.label :specialist, t(:agentic_ppm_specialist) %>
        <%= form.select :specialist, options_for_select(["PMO", "VRO"]) %>
      </p>
      <p>
        <%= form.label :prompt, t(:agentic_ppm_prompt) %>
        <%= form.text_area :prompt, required: true, rows: 4 %>
      </p>
      <%= form.submit t(:agentic_ppm_send_to_specialist), class: "button -primary" %>
    <% end %>
  </section>
<% end %>
