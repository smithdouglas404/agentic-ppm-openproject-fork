# Mac Studio Docker Desktop environment for the native Agentic PPM OpenProject fork.
# Copy to .env.macstudio and fill every required value before starting.
# Never commit .env.macstudio.

# OpenProject build/runtime
LOCAL_DEV_CHECK=1
DEV_UID=1000
DEV_GID=1000
OPENPROJECT_EDITION=standard
OPENPROJECT_DOCKER_DEV_TLD=local
PORT=3000
FE_PORT=4200

# Native OpenProject -> local agent runtime
AGENTIC_PPM_DURABLE_WORKFLOW_ENABLED=true
AGENTIC_PPM_AGENT_RUNTIME_BASE_URL=http://agent-runtime
AGENTIC_PPM_AGENT_RUNTIME_KEY=replace-with-long-random-agent-key
AGENTIC_PPM_ALLOW_INSECURE_SERVICE_URLS=true
AGENT_BACKEND_KEY=replace-with-long-random-agent-key

# OpenProject database
DB_USERNAME=postgres
DB_PASSWORD=replace-with-long-random-openproject-db-password
DB_DATABASE=openproject
DB_HOST=db
DB_PORT=5432

# Supporting relational database
MYSQL_ROOT_PASSWORD=replace-with-long-random-governance-db-password
MYSQL_DATABASE=governance

# Local agent/memory PostgreSQL with pgvector
AGENT_POSTGRES_USER=agentic
AGENT_POSTGRES_PASSWORD=replace-with-long-random-agent-postgres-password
AGENT_POSTGRES_DB=agentic

# Model provider credentials. At least one supported provider and an embedder are required for memory writes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LiteLLM
LITELLM_API_KEY=replace-with-long-random-litellm-key
LITELLM_PORT=4000

# Mem0
MEM0_API_KEY=replace-with-long-random-mem0-api-key
MEM0_JWT_SECRET=replace-with-long-random-mem0-jwt-secret
MEM0_PORT=8888
MEM0_IMAGE=mem0/mem0-api-server:latest

# Letta
LETTA_TOKEN=replace-with-long-random-letta-password
LETTA_PORT=8283
LETTA_IMAGE=letta/letta:latest

# RAGLite local evidence retrieval
RAGLITE_PORT=8080
RAGLITE_API_KEY=
RAGLITE_URL=http://raglite:8080
RAG_SSE_URL=

# Langflow
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=replace-with-long-random-langflow-password
LANGFLOW_PORT=7860
LANGFLOW_IMAGE=langflowai/langflow:latest

# Memgraph and ontology store
MEMGRAPH_PASSWORD=replace-with-long-random-memgraph-password
MEMGRAPH_BOLT_PORT=7687
MEMGRAPH_LAB_PORT=3002
FUSEKI_ADMIN_PASSWORD=replace-with-long-random-fuseki-password
FUSEKI_PORT=3030

# Retained rich UI
RICH_UI_PORT=8080

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ppm-local
